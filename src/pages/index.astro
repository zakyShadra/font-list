---
import "../styles/global.css";
import Card from "../components/Card.astro";
import { PAIRINGS, FONT_FAMILIES, CATEGORIES } from "../data/pairings";
import { SPOTTED } from "../data/spotted";

const fontHrefs = FONT_FAMILIES.map(
  (family) =>
    `https://fonts.googleapis.com/css2?family=${family.replace(/ /g, "+")}:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap`
);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Font Pairing — Showcase</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {fontHrefs.map((href) => <link rel="stylesheet" href={href} />)}
</head>
<body>
  <div class="wrap">
    <header class="top">
      <p class="kicker">Font pairing · live preview</p>
      <h1 class="intro">See the type before you commit to it.</h1>
      <p class="intro-note">
        Every card is rendered in the portfolio's own palette (near-black, paper,
        vermillion). Read the headline, then the paragraph — that's the test that
        matters. Pick a number, then tell the agent which one to apply.
      </p>
    </header>

    <div class="toolbar">
      <input type="search" id="search" placeholder="Search a font, mood, or style…" autocomplete="off" />
      <select id="category-select">
        {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
    <div class="grid" id="grid">
      {PAIRINGS.map((p) => <Card pairing={p} />)}
    </div>

    <section class="spotted">
      <div class="spotted-head">
        <h2>Spotted in "Album Font: Nyebrang Tapi Jodoh"</h2>
        <p>
          Font pairings from Kang Desain's (@fajarnyeni) ebook. None of these are
          live-rendered here — licenses are mixed (several are personal-use-only)
          so we don't self-host them. Where we tracked down a real free download,
          the name links straight to the original host. A <span class="tag-paid">premium</span>
          tag means it turned out to be paid — some of the ebook's own "free
          download" links actually redirect to Envato Elements or a commercial
          foundry — so there's nothing to link to.
        </p>
        <p class="note">NO LIVE PREVIEW · LINKS GO TO THE ORIGINAL SOURCE · CHECK EACH LICENSE BEFORE COMMERCIAL USE</p>
      </div>
      {SPOTTED.map((group) => (
        <div class="spotted-group">
          <h3>{group.theme}</h3>
          <ul class="spotted-list">
            {group.pairs.map((pair) => (
              <li>
                {typeof pair === "string" ? (
                  pair
                ) : (
                  pair.fonts.map((f, i) => (
                    <>
                      {i > 0 && " + "}
                      {f.status === "free" ? (
                        <a href={f.url} target="_blank" rel="noopener noreferrer" title={f.note}>{f.name} ↓</a>
                      ) : (
                        <span class="unlinked" title={f.note}>
                          {f.name}
                          {(f.status === "paid" || f.status === "paid-commercial") && <span class="tag-paid">premium</span>}
                        </span>
                      )}
                    </>
                  ))
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>

  <footer class="wrap">
    Fonts via Google Fonts (open-source). Catalog: <code>pairings.md</code>.
  </footer>

  <script>
    const search = document.getElementById("search") as HTMLInputElement;
    const categorySelect = document.getElementById("category-select") as HTMLSelectElement;
    const cards = document.querySelectorAll<HTMLElement>("#grid .card");

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const cat = categorySelect.value;
      cards.forEach((card) => {
        const matchesCat = cat === "All" || card.dataset.cat === cat;
        const matchesSearch = !query || (card.dataset.search ?? "").includes(query);
        card.hidden = !(matchesCat && matchesSearch);
      });
    }

    search.addEventListener("input", applyFilters);
    categorySelect.addEventListener("change", applyFilters);
  </script>
</body>
</html>
