---
import "../styles/global.css";
import "../styles/spotted-fonts.css";
import Card from "../components/Card.astro";
import SpottedLiveCard from "../components/SpottedLiveCard.astro";
import { PAIRINGS, FONT_FAMILIES, CATEGORIES } from "../data/pairings";
import { LIVE_PAIRS, GOOGLE_FONTS, PREMIUM_CATEGORIES } from "../data/spottedLive";

const allFamilies = [...new Set([...FONT_FAMILIES, ...GOOGLE_FONTS])];
const fontHrefs = allFamilies.map(
  (family) =>
    `https://fonts.googleapis.com/css2?family=${family.replace(/ /g, "+")}:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap`
);

const IG_URL = "https://www.instagram.com/fajarnyeni?utm_source=ig_web_button_share_sheet&stkn=ZDNlZDc0MzIxNw==";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Font Pairing — Showcase</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {fontHrefs.map((href) => <link rel="stylesheet" href={href} />)}
</head>
<body>
  <div class="wrap">
    <header class="top">
      <p class="kicker">Font pairing · live preview</p>
      <h1 class="intro">See the type before you commit to it.</h1>
      <p class="intro-note">
        Every card is rendered in the portfolio's own palette (near-black, paper,
        vermillion). Read the headline, then the paragraph — that's the test that
        matters. Pick a number, then tell the agent which one to apply.
      </p>
    </header>

    <div class="toolbar">
      <input type="search" id="search" placeholder="Search a font, mood, or style…" autocomplete="off" />
      <select id="category-select">
        <option value="All">All</option>
        <optgroup label="Premium">
          {PREMIUM_CATEGORIES.map((c) => <option value={`premium:${c}`}>{c}</option>)}
        </optgroup>
        <optgroup label="Standar">
          {CATEGORIES.filter((c) => c !== "All").map((c) => <option value={`standard:${c}`}>{c}</option>)}
        </optgroup>
      </select>
    </div>

    <section class="spotted premium-section">
      <div class="spotted-head">
        <h2>Combo font yang nyebrang tapi nyambung — source by: <a href={IG_URL} target="_blank" rel="noopener noreferrer">fajarnyeni</a></h2>
        <p>
          {LIVE_PAIRS.length} pasangan font premium dari ebook "Album Font: Nyebrang Tapi
          Jodoh", di-self-host dari file aslinya dan dirender beneran di sini — bukan
          screenshot. Nama tiap font ngelink ke sumber download aslinya.
        </p>
      </div>
      <div class="live-grid" id="premium-grid">
        {LIVE_PAIRS.map((pairing, i) => <SpottedLiveCard pairing={pairing} index={i + 1} />)}
      </div>
    </section>

    <section class="mine-section">
      <div class="spotted-head">
        <h2>Saran font standar</h2>
      </div>
      <div class="grid" id="grid">
        {PAIRINGS.map((p) => <Card pairing={p} />)}
      </div>
    </section>
  </div>

  <footer class="wrap">
    Fonts via Google Fonts (open-source). Catalog: <code>pairings.md</code>.
    Source by: "Album Font: Nyebrang Tapi Jodoh (All Series)" — thanks to: <a href={IG_URL} target="_blank" rel="noopener noreferrer">fajarnyeni</a>.
  </footer>

  <script>
    const search = document.getElementById("search") as HTMLInputElement;
    const categorySelect = document.getElementById("category-select") as HTMLSelectElement;
    const cards = document.querySelectorAll<HTMLElement>("#premium-grid .live-card, #grid .card");

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const value = categorySelect.value;
      const [group, cat] = value === "All" ? [null, null] : value.split(/:(.*)/s);
      cards.forEach((card) => {
        const matchesCat = value === "All" || (card.dataset.group === group && card.dataset.cat === cat);
        const matchesSearch = !query || (card.dataset.search ?? "").includes(query);
        card.hidden = !(matchesCat && matchesSearch);
      });
    }

    search.addEventListener("input", applyFilters);
    categorySelect.addEventListener("change", applyFilters);
  </script>
</body>
</html>
