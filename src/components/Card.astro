---
import { FALLBACKS } from "../data/pairings";

const { pairing: p } = Astro.props;

const style = `--d:'${p.d}', ${FALLBACKS.serif}; --b:'${p.b}', ${FALLBACKS.sans}; --m:'${p.m || p.b}', ${FALLBACKS.mono};`;
const search = `${p.name} ${p.d} ${p.b} ${p.m || ""} ${p.mood} ${p.cat}`.toLowerCase();
const gfUrl = (family) => `https://fonts.google.com/specimen/${family.replace(/ /g, "+")}`;
---
<article class="card" data-group="standard" data-cat={p.cat} data-search={search} style={style}>
  <div class="card-shape" aria-hidden="true"></div>

  <div class="card-head">
    <span class="card-badge">{String(p.n).padStart(2, "0")}</span>
    <span class="card-cat">{p.cat}</span>
  </div>

  <div class="card-specimen">
    <div class="card-d" style="font-family:var(--d)">{p.d}</div>
    <div class="card-sample" style="font-family:var(--b)">
      <p class="card-sample-text">The quick brown fox jumps over the lazy dog</p>
      <p class="card-sample-caps">THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG</p>
      <p class="card-sample-num">0123456789</p>
    </div>
  </div>

  <p class="card-why">{p.why}</p>

  <div class="card-foot">
    <a class="card-font-link" href={gfUrl(p.d)} target="_blank" rel="noopener noreferrer">
      <span class="card-font-name" style="font-family:var(--d)">{p.d}</span>
      <span class="card-dl">View on Google Fonts ↗</span>
    </a>
    <a class="card-font-link" href={gfUrl(p.b)} target="_blank" rel="noopener noreferrer">
      <span class="card-font-name" style="font-family:var(--b)">{p.b}</span>
      <span class="card-dl">View on Google Fonts ↗</span>
    </a>
    {p.m && (
      <a class="card-font-link" href={gfUrl(p.m)} target="_blank" rel="noopener noreferrer">
        <span class="card-font-name" style="font-family:var(--m)">{p.m}</span>
        <span class="card-dl">View on Google Fonts ↗</span>
      </a>
    )}
  </div>

  <div class="card-mood">{p.mood}</div>
</article>
