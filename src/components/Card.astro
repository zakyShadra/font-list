---
import { FALLBACKS } from "../data/pairings";

const { pairing: p } = Astro.props;

const style = `--d:'${p.d}', ${FALLBACKS.serif}; --b:'${p.b}', ${FALLBACKS.sans}; --m:'${p.m || p.b}', ${FALLBACKS.mono};`;
---
<article class="card" data-cat={p.cat} style={style}>
  <div class="card-head">
    <span class="card-name"><b>{String(p.n).padStart(2, "0")}</b> &nbsp;{p.name}</span>
    <span class="card-num">{p.cat}</span>
  </div>
  <div class="specimen">
    <div class="d" style="font-family:var(--d)">{p.d}</div>
    <div class="d2" style="font-family:var(--d)"><i>Aa Bg</i> 0123</div>
    <p class="b" style="font-family:var(--b)">The quick brown fox jumps over the lazy dog.</p>
    <div class="m" style="font-family:var(--m)">{p.m || p.b} · AaBb 0123</div>
  </div>
  <div class="why">{p.why}</div>
  <div class="card-foot">
    <span class="mood">{p.mood}</span>
    <span class="roles">
      <span>D {p.d}</span><span>B {p.b}</span>{p.m && <span>M {p.m}</span>}
    </span>
  </div>
</article>
