---
const { pairing, index } = Astro.props;
const { theme, d, b } = pairing;

const style = `--d:'${d.name}', system-ui, sans-serif; --b:'${b.name}', system-ui, sans-serif;`;
const search = `${d.name} ${b.name} ${theme}`.toLowerCase();
---
<article class="live-card" data-group="premium" data-cat={theme} data-search={search} style={style}>
  <div class="live-shape live-shape-a" aria-hidden="true"></div>
  <div class="live-shape live-shape-b" aria-hidden="true"></div>
  <span class="live-dot" aria-hidden="true"></span>

  <div class="live-head">
    <span class="live-badge">{String(index).padStart(2, "0")}</span>
    <span class="live-theme">{theme}</span>
  </div>

  <div class="live-specimen">
    <div class="live-d" style="font-family:var(--d)">{d.name}</div>
    <div class="live-sample" style="font-family:var(--b)">
      <p class="live-sample-text">The quick brown fox jumps over the lazy dog</p>
      <p class="live-sample-caps">THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG</p>
      <p class="live-sample-num">0123456789</p>
    </div>
  </div>

  <div class="live-foot">
    <a class="live-font-link" href={d.url} target="_blank" rel="noopener noreferrer">
      <span class="live-tag">+ Nama Fontnya</span>
      <span class="live-name" style="font-family:var(--d)">{d.name}</span>
      <span class="live-dl">Click disini buat download font ↗</span>
    </a>
    <a class="live-font-link" href={b.url} target="_blank" rel="noopener noreferrer">
      <span class="live-tag">+ Nama Fontnya</span>
      <span class="live-name" style="font-family:var(--b)">{b.name}</span>
      <span class="live-dl">Click disini buat download font ↗</span>
    </a>
  </div>
</article>
